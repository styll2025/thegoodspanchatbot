// Parallel evaluation Worker (a separate project from the live evaluation).
// Before the first deploy: create a new KV namespace in Cloudflare and put its id below.
// Keep "name" different from the live Worker (goodspan-longevity-map), or the deploy replaces the live evaluation.
{
  "name": "goodspan-evaluation-v2",
  "main": "worker.js",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  "kv_namespaces": [
    {
      "binding": "PLANS",
      "id": "REPLACE_WITH_NEW_KV_NAMESPACE_ID"
    }
  ]
}
